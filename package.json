{
  "name": "sacred-commerce",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run --config vitest.config.ts && tsx scripts/integration.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "tsx scripts/integration.ts",
    "test:e2e": "playwright test",
    "test:auth:hosted": "playwright test --config playwright.hosted-auth.config.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "prisma db seed",
    "auth:provision": "tsx scripts/provision-demo-profiles.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "dotenv": "18.0.7",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
